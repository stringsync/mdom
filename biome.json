{
	"$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!skills-lock.json",
			"!**/catalog/*/evals",
			"!.vet/rules/*/evals",
			"!packages/core"
		]
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"useBlockStatements": "error",
				"useNamingConvention": {
					"level": "error",
					"options": {
						"conventions": [
							{
								"selector": {
									"kind": "typeLike"
								},
								"match": "([^I].*|I|I[^A-Z].*)"
							},
							{
								"selector": {
									"kind": "variable"
								},
								"match": "(.{2,}|[ijk])"
							},
							{
								"selector": {
									"kind": "functionParameter"
								},
								"match": "(.{2,}|[ijk])"
							},
							{
								"selector": {
									"kind": "any"
								},
								"match": ".*"
							}
						]
					}
				},
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"patterns": [
							{
								"group": ["**/packages/**"],
								"message": "Import the package's public API (its name and an exports subpath) instead of reaching into packages/."
							}
						]
					}
				},
				"noNonNullAssertion": "off"
			},
			"correctness": {
				"noUndeclaredDependencies": "error"
			}
		}
	},
	"formatter": {
		"enabled": true
	},
	"overrides": [
		{
			"includes": ["**/react/**"],
			"linter": {
				"domains": {
					"react": "recommended"
				}
			}
		}
	]
}
